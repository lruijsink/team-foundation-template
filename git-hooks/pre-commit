#!/usr/bin/env bash
set -euo pipefail

# Resolve lint.sh/format.sh relative to this script's own location, not the caller's cwd - core.hooksPath can point
# at a hooks dir outside the repo being committed to, in which case those scripts don't live at the repo root.
# lint.sh/format.sh live in tools/, next to git-hooks/.

# Find the `tools/` directory in this repository, relative to this script's location.
tools_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/../tools" && pwd)

# Execute from repo root
cd "$(git rev-parse --show-toplevel)"

# Off by default - opt in per clone with `git config hooks.auto-format true`.
autofix=$(git config --bool hooks.auto-format 2> /dev/null || echo false)

# ACMR: added/copied/modified/renamed - excludes deletions, nothing to lint there.
files=$(git diff --cached --name-only --diff-filter=ACMR)

# A file can be partially staged, so what's on disk isn't necessarily what's about to be committed. This script creates
# temp files with the staged contents only, and lints those. They live under the repo root - rather than something
# like `/tmp/` - so that config files (e.g. `.editorconfig`, `.prettierrc`) are still resolved via upward search.
tmp_root=.lint-tmp

# Clean up the temp files afterwards, even if this script fails
trap 'rm -rf "$tmp_root"' EXIT

# Exit status to-be: don't exit early, always lint each file to display all files that don't pass linting
status=0

while IFS= read -r file; do # not `for file in $files`, as that splits on spaces/glob-expands special chars
  [ -z "$file" ] && continue

  # Only auto-format fully staged files, to not `git add` unstaged changes.
  # Not suppressed like the rest of this script's linter calls - format.sh
  # reports what it fixed and, importantly, what it couldn't.
  if [ "$autofix" = true ] && git diff --quiet -- "$file"; then
    "$tools_dir/format.sh" "$file" || true
    git add -- "$file"
  fi

  # Fetch the staged contents with `git show` into a temp file and lint it
  tmp_path="$tmp_root/$file"
  mkdir -p "$(dirname "$tmp_path")"
  git show ":$file" > "$tmp_path" 2> /dev/null || true
  if ! "$tools_dir/lint.sh" "$tmp_path" > /dev/null 2>&1; then
    [ "$status" -eq 0 ] && echo "Commit rejected:"
    echo "  $file"
    status=1
  fi
done <<< "$files" # Use here-string instead of pipe to not lose `status` updates to a subshell

exit "$status"
