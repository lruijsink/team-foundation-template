{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "git add \"$(jq -r '.tool_input.file_path')\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$(git config --type=bool --get hooks.claude.autoFormat)\" = \"true\" ]; then tools/linter.sh -w \"$(jq -r '.tool_input.file_path')\"; fi"
          }
        ]
      }
    ]
  }
}
